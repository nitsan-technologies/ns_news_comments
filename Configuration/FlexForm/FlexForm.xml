<T3DataStructure>
    <meta>
        <langDisable>1</langDisable>
    </meta>

    <sheets>
        <!--
            ################################
              SHEET General Settings
            ################################
        -->
        <sDEF>
            <ROOT>
                <sheetTitle>LLL:EXT:ns_news_comments/Resources/Private/Language/locallang_db.xlf:flexform.setting</sheetTitle>
                <type>array</type>

                <el>

                    <settings.global>
                        <label>LLL:EXT:ns_news_comments/Resources/Private/Language/locallang_db.xlf:flexform.timeFormat.3</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </settings.global>

                    <settings.dateFormat>
                        <label>LLL:EXT:ns_news_comments/Resources/Private/Language/locallang_db.xlf:flexform.dateFormat</label>
                        <displayCond>FIELD:settings.global:!=:1</displayCond>
                        <config>
                            <type>input</type>
                            <eval>trim,required</eval>
                            <default>F j, Y</default>
                        </config>
                    </settings.dateFormat>

                    <settings.timeFormat>
                        <label>LLL:EXT:ns_news_comments/Resources/Private/Language/locallang_db.xlf:flexform.timeFormat</label>
                        <displayCond>FIELD:settings.global:!=:1</displayCond>
                        <config>
                            <type>input</type>
                            <eval>trim,required</eval>
                            <default>g:i a</default>
                        </config>
                    </settings.timeFormat>

                    <settings.captcha>
                        <label>LLL:EXT:ns_news_comments/Resources/Private/Language/locallang_db.xlf:flexform.captcha</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </settings.captcha>

                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>